{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spectrometer Measurement",
  "type": "object",
  "required": ["experiment_id", "instrument", "operator", "measurement", "scan_parameters", "spectrum"],
  "properties": {
    "experiment_id": { "type": "string" },

    "instrument": {
      "type": "object",
      "required": ["name", "manufacturer", "resolution_cm-1"],
      "properties": {
        "name": { "type": "string" },
        "manufacturer": { "type": "string" },
        "resolution_cm-1": { "type": "number" }
      }
    },

    "operator": {
      "type": "object",
      "required": ["name", "lab"],
      "properties": {
        "name": { "type": "string" },
        "lab": { "type": "string" }
      }
    },

    "measurement": {
      "type": "object",
      "required": ["date", "location", "temperature_C", "pressure_hPa"],
      "properties": {
        "date": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "temperature_C": { "type": "number" },
        "pressure_hPa": { "type": "number" }
      }
    },

    "scan_parameters": {
      "type": "object",
      "required": ["number_of_scans", "scan_velocity_kHz", "apodization"],
      "properties": {
        "number_of_scans": { "type": "integer" },
        "scan_velocity_kHz": { "type": "number" },
        "apodization": { "type": "string" }
      }
    },

    "spectrum": {
      "type": "object",
      "required": ["wavenumber_range_cm-1", "data_file"],
      "properties": {
        "wavenumber_range_cm-1": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "data_file": { "type": "string" }
      }
    }
  }
}
